# Copy this file to sandbox.env and fill in real values.
#   cp config/sandbox.env.example config/sandbox.env
#
# sandbox.env is git-ignored. Never commit real endpoints or keys here.

# OpenAI-compatible endpoint 
# If served by oMLX/Qwen (or splash) locally on the host, set it to the synthetic fixed hostname
# you only need to adjust port and /v1 matching your local API
# Apple synthetic IP is redirected to host loopback 127.0.0.1 through macOS packet-filter rules
# Alternatively, set an external API on the internet (e.g. OpenRouter)
OPENAI_BASE_URL=http://host.container.internal:8000/v1

# Placeholder credential. Many local OpenAI-compatible servers accept any
# non-empty string. Replace only if your local engine requires a real key.
OPENAI_API_KEY=local-only-placeholder

# Resource overrides (see bin/pcs start). Leave unset to use the
# built-in defaults (8 CPUs / 16G memory).
PI_SANDBOX_CPUS=8
PI_SANDBOX_MEMORY=16G

# Uncomment to override the image tag or container name used by the scripts.
# PI_SANDBOX_IMAGE=local/pi-dev:trixie
# PI_SANDBOX_NAME=pi-sandbox

# Host folder (your project) bind-mounted read-write at /workspace in the
# sandbox, including .git — so pi works fully with your project in place.
# Set it with:  pcs start --workspace-source /path/to/project
# The scripts write it here automatically on first use, so you normally
# never need to edit it. Everything in the folder is readable/writable by
# pi inside the sandbox — do NOT point it at folders containing credentials
# or tokens pi should not access.
# PI_SANDBOX_WORKSPACE_SOURCE="/path/to/project"

# Uncomment to override the endpoint used only by pcs verify's
# connectivity check if it differs from OPENAI_BASE_URL.
# PI_SANDBOX_QWEN_URL=http://host.container.internal:8000/v1

# Pi extensions that must be present in the sandbox. When pcs start runs,
# each entry is checked with `pi list` inside the container and installed
# with `pi install` if missing (installs persist in home-agent/.pi).
# Space- or comma-separated. A bare name like "pi-permission-system" is
# resolved as an npm package; you may also use explicit pi package sources
# ("npm:@scope/pkg", "git:github.com/user/repo", a URL, or a local path).
# PI_SANDBOX_EXTENSIONS="pi-web-access"
PI_SANDBOX_EXTENSIONS="pi-web-access"
